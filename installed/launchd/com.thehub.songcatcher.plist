<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thehub.songcatcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/thehub/Library/Application Support/Songcatcher/venv/bin/python3</string>
        <string>/Users/thehub/Library/Application Support/Songcatcher/songcatcherd.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/thehub/Library/Application Support/Songcatcher</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/Users/thehub/Library/Logs/Songcatcher/daemon.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/thehub/Library/Logs/Songcatcher/daemon.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
